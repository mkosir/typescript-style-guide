{
  "name": "typescript-style-guide-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "tsc": "tsc -p tsconfig.json",
    "format:fix": "prettier --config .prettierrc --write --ignore-unknown -l .",
    "clean": "rm -rf node_modules coverage dist compiled build .docusaurus"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-animate-height": "3.2.4",
    "react-dom": "19.2.8",
    "react-parallax-tilt": "1.7.339",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/mdx-loader": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@eslint/js": "9.29.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=26.8.1"
  }
}
